# Salin ke .env.local (lokal) atau isi di dasbor hosting. Jangan commit nilai asli.
TURSO_DATABASE_URL=libsql://nama-db.turso.io
TURSO_AUTH_TOKEN=
# Hasil `npm run admin:hash -- "kata sandi"`.
ADMIN_PASSWORD_HASH=
# String acak panjang, minimal 32 karakter. Tanpa ini sesi memakai hash sandi sebagai kunci.
ADMIN_SESSION_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_MODE=sandbox
# Hanya untuk pengembangan lokal; kosongkan di produksi.
LOCAL_ADMIN=yes
